---
import Base from "~/layouts/Base.astro";

interface Props {
  title: string;
  description: string;
  /** Shown under the title, e.g. a publish or "last updated" date. */
  dateline: string;
  back?: { label: string; href: string };
}

const { title, description, dateline, back } = Astro.props;
---

<Base title={title} description={description}>
  <article class="container prose-page">
    <header>
      {back && <a href={back.href}>{back.label}</a>}
      <h1>{title}</h1>
      <p class="dateline">{dateline}</p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  .prose-page {
    max-width: 42rem;
    padding-block: 4rem 6rem;
  }

  header a {
    font-size: var(--step--1);
  }

  h1 {
    margin-top: 0.75rem;
    font-size: var(--step-4);
    font-weight: 800;
  }

  .dateline {
    margin-top: 0.75rem;
    color: var(--ink-3);
  }

  .prose {
    margin-top: 3rem;
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .prose :global(:is(p, ul, ol, pre, blockquote, figure) + *) {
    margin-top: 1.25em;
  }

  .prose :global(h2) {
    margin-top: 2.5em;
    font-size: var(--step-2);
  }

  .prose :global(h2 + *) {
    margin-top: 0.75em;
  }

  .prose :global(li + li) {
    margin-top: 0.4em;
  }

  .prose :global(pre) {
    padding: 1rem 1.25rem;
    overflow-x: auto;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    font-size: 0.9rem;
  }

  .prose :global(blockquote) {
    margin-inline: 1.5rem;
    font-style: italic;
    color: var(--ink-2);
  }
</style>
