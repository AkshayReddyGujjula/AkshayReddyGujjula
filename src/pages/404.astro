---
import Base from "~/layouts/Base.astro";
---

<Base title="Page not found">
  <div class="container missing">
    <p class="code">404</p>
    <h1>There's no node here.</h1>
    <p>The page you followed doesn't exist, or it moved. Try the <a href="/">home page</a>, or press <kbd data-shortcut>Ctrl K</kbd> to search.</p>
  </div>
</Base>

<style>
  .missing {
    max-width: 40rem;
    padding-block: 18vh 20vh;
  }

  .code {
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  h1 {
    margin-top: 0.5rem;
    font-size: var(--step-4);
    font-weight: 800;
  }

  p:last-child {
    margin-top: 1rem;
    font-size: var(--step-1);
    color: var(--ink-2);
  }

  kbd {
    padding: 0.1em 0.4em;
    border: 1px solid var(--line);
    border-radius: 5px;
    font: inherit;
    font-size: 0.85em;
  }
</style>
