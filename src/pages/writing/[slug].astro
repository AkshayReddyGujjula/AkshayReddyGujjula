---
import { type CollectionEntry, render } from "astro:content";
import Prose from "~/layouts/Prose.astro";
import { publishedWriting } from "~/lib/content";

export async function getStaticPaths() {
  const posts = await publishedWriting();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"writing">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = new Intl.DateTimeFormat("en-GB", { dateStyle: "long" }).format(post.data.published);
---

<Prose
  title={post.data.title}
  description={post.data.description}
  dateline={date}
  back={{ label: "Writing", href: "/writing" }}
>
  <Content />
</Prose>
