---
import { profile } from "~/data/profile";

const year = new Date().getFullYear();
---

<footer class="container">
  <p class="signoff">
    I build software, <em>then I make it faster.</em>
  </p>
  <p class="status"><span aria-hidden="true"></span>Open to collaborations — email is quickest</p>
  <div class="row">
    <p>© {year} {profile.fullName} · Hand-built with Astro · No cookies, no analytics</p>
    <nav aria-label="Site information">
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="https://github.com/AkshayReddyGujjula/AkshayReddyGujjula">Source</a>
    </nav>
  </div>
</footer>

<style>
  footer {
    padding-block: clamp(4rem, 10vw, 7rem) 3rem;
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  .signoff {
    max-width: 24ch;
    font-size: clamp(1.4rem, 1.1rem + 1.6vw, 2.1rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .signoff em {
    font-style: normal;
    color: var(--accent);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .status span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 2rem;
  }

  nav {
    display: flex;
    gap: 1.25rem;
  }

  @media print {
    footer {
      display: none;
    }
  }
</style>
