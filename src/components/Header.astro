---
import { profile } from "~/data/profile";
import { hasPublishedWriting } from "~/lib/content";

const links = [
  { label: "Work", href: "/#work" },
  { label: "Hackathons", href: "/#hackathons" },
  { label: "About", href: "/#about" },
  ...((await hasPublishedWriting()) ? [{ label: "Writing", href: "/writing" }] : []),
  { label: "CV", href: "/cv" },
  { label: "Contact", href: "/#contact" },
];
---

<header class="bar">
  <div class="inner">
    <a class="name" href="/">{profile.name}</a>
    <nav aria-label="Main">
      <ul>
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>
    <div class="tools">
      <button class="palette" type="button" data-palette-open aria-label="Open command palette">
        <span>Search</span><kbd data-shortcut>Ctrl K</kbd>
      </button>
      <button class="theme" type="button" data-theme-toggle aria-label="Switch colour theme">
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="10" cy="10" r="4.5"></circle>
          <path d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2M4 4l1.4 1.4M14.6 14.6 16 16M4 16l1.4-1.4M14.6 5.4 16 4"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  import { toggleTheme } from "~/lib/theme";

  const isMac = /Mac|iPhone|iPad/.test(navigator.userAgent);
  for (const kbd of document.querySelectorAll("[data-shortcut]")) {
    kbd.textContent = isMac ? "⌘K" : "Ctrl K";
  }
  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => toggleTheme());
  document
    .querySelector("[data-palette-open]")
    ?.addEventListener("click", () => window.dispatchEvent(new Event("palette:open")));
</script>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    width: min(100% - 2 * var(--gutter), var(--content));
    margin-inline: auto;
    height: 3.75rem;
  }

  .name {
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-decoration: none;
  }

  ul {
    display: flex;
    gap: 1.5rem;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
  }

  nav a {
    color: var(--ink-2);
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    nav a:hover {
      color: var(--ink);
    }

    button:hover {
      border-color: var(--ink-3);
      color: var(--ink);
    }
  }

  .tools {
    display: flex;
    gap: 0.5rem;
    margin-left: auto;
  }

  button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    height: 2.25rem;
    padding: 0 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink-2);
    font-size: var(--step--1);
    cursor: pointer;
  }

  kbd {
    font: inherit;
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .theme {
    width: 2.25rem;
    padding: 0;
    justify-content: center;
  }

  .theme svg {
    width: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  @media (max-width: 52rem) {
    nav {
      display: none;
    }

    .palette span {
      display: none;
    }
  }

  @media print {
    .bar {
      display: none;
    }
  }
</style>
