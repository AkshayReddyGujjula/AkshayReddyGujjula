---
import { profile } from "~/data/profile";
import { hasPublishedWriting } from "~/lib/content";

const links = [
  { label: "Work", href: "/#studycanvas" },
  { label: "Optimising", href: "/#optimising" },
  { label: "Hackathons", href: "/#hackathons" },
  ...((await hasPublishedWriting()) ? [{ label: "Writing", href: "/writing" }] : []),
  { label: "CV", href: "/cv" },
  { label: "Contact", href: "/#contact" },
];
---

<header class="bar" data-bar>
  <span class="progress" aria-hidden="true"></span>
  <div class="inner">
    <a class="name" href="/">{profile.name}</a>
    <nav class="desktop" aria-label="Main">
      <ul>
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>
    <button class="palette" type="button" data-palette-open aria-label="Open command palette">
      <span>Search</span><kbd data-shortcut>Ctrl K</kbd>
    </button>
    <button
      class="menu-toggle"
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" data-icon-open>
        <path
          d="M2 4h12M2 8h12M2 12h12"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        ></path>
      </svg>
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" data-icon-close data-hidden>
        <path
          d="M4 4l8 8M12 4l-8 8"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        ></path>
      </svg>
    </button>
  </div>
  <nav id="mobile-menu" class="mobile" aria-label="Mobile" data-mobile-nav hidden>
    <ul>
      {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  </nav>
</header>

<script>
  const isMac = /Mac|iPhone|iPad/.test(navigator.userAgent);
  for (const kbd of document.querySelectorAll("[data-shortcut]")) {
    kbd.textContent = isMac ? "⌘K" : "Ctrl K";
  }
  document
    .querySelector("[data-palette-open]")
    ?.addEventListener("click", () => window.dispatchEvent(new Event("palette:open")));

  // The bar stays transparent over the hero canvas and gains a solid ground once
  // ordinary content scrolls under it.
  const bar = document.querySelector<HTMLElement>("[data-bar]");
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const update = () => {
    const past = hero ? hero.getBoundingClientRect().bottom <= (bar?.offsetHeight ?? 0) : true;
    bar?.toggleAttribute("data-scrolled", past && window.scrollY > 8);
  };
  window.addEventListener("scroll", update, { passive: true });
  update();

  // Compact menu for phone and tablet widths. Links reuse the desktop
  // destinations; focus is never trapped, Escape or a link dismisses it.
  const menuToggle = document.querySelector("[data-menu-toggle]");
  const mobileNav = document.querySelector("[data-mobile-nav]");
  const iconOpen = document.querySelector("[data-icon-open]");
  const iconClose = document.querySelector("[data-icon-close]");

  const setMenuOpen = (open: boolean) => {
    menuToggle?.setAttribute("aria-expanded", String(open));
    menuToggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    if (open) {
      mobileNav?.removeAttribute("hidden");
    } else {
      mobileNav?.setAttribute("hidden", "");
    }
    bar?.toggleAttribute("data-menu-open", open);
    iconOpen?.toggleAttribute("data-hidden", open);
    iconClose?.toggleAttribute("data-hidden", !open);
  };

  menuToggle?.addEventListener("click", () => {
    const open = menuToggle.getAttribute("aria-expanded") !== "true";
    setMenuOpen(open);
  });

  mobileNav?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) {
      setMenuOpen(false);
    }
  });

  document.addEventListener("pointerdown", (event) => {
    if (menuToggle?.getAttribute("aria-expanded") === "true" && !bar?.contains(event.target as Node)) {
      setMenuOpen(false);
    }
  });

  document.querySelector("[data-palette-open]")?.addEventListener("click", () => setMenuOpen(false));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menuToggle?.getAttribute("aria-expanded") === "true") {
      setMenuOpen(false);
      (menuToggle as HTMLButtonElement).focus();
    }
  });

  window.matchMedia("(min-width: 56.001rem)").addEventListener("change", (event) => {
    if (event.matches) {
      setMenuOpen(false);
    }
  });
</script>

<style>
  .bar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    transition:
      background-color 300ms var(--ease-out),
      box-shadow 300ms var(--ease-out);
  }

  /* On the home page the bar waits for the hero's opening, then arrives after it. */
  :global(body:has([data-hero])) .bar {
    animation: arrive 900ms var(--ease-out) 1400ms backwards;
  }

  /* How far down the page you are, as a hairline under the bar. Pure CSS, no scroll handler. */
  .progress {
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: var(--accent);
    transform-origin: left;
    scale: 0 1;
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    .progress {
      display: block;
      animation: progress linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes progress {
    to {
      scale: 1 1;
    }
  }

  .bar[data-scrolled],
  .bar[data-menu-open] {
    background: var(--bg);
    box-shadow: inset 0 -1px 0 var(--line);
  }

  .bar[data-menu-open] {
    transition: none;
  }

  @keyframes arrive {
    from {
      opacity: 0;
      translate: 0 -0.5rem;
    }
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    width: min(100% - 2 * var(--gutter), var(--content));
    margin-inline: auto;
    height: 4rem;
  }

  .name {
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  .desktop {
    margin-left: auto;
  }

  .desktop ul {
    display: flex;
    gap: 1.75rem;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
  }

  .desktop a {
    color: var(--ink-2);
    text-decoration: none;
    transition: color 160ms var(--ease-out);
  }

  button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    height: 2.25rem;
    padding: 0 0.8rem;
    border: 0;
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1px var(--line);
    background: none;
    color: var(--ink-2);
    font-size: var(--step--1);
    transition:
      box-shadow 160ms var(--ease-out),
      color 160ms var(--ease-out),
      scale 160ms var(--ease-out);
  }

  button:active {
    scale: 0.97;
  }

  .menu-toggle {
    display: none;
    width: 2.25rem;
    padding: 0;
    flex-shrink: 0;
    justify-content: center;
  }

  .menu-toggle svg {
    display: block;
  }

  .menu-toggle svg[data-hidden] {
    display: none;
  }

  .mobile[hidden] {
    display: none;
  }

  .mobile {
    border-top: 1px solid var(--line);
  }

  .mobile ul {
    display: flex;
    flex-direction: column;
    width: min(100% - 2 * var(--gutter), var(--content));
    margin-inline: auto;
    padding: 0.25rem 0 0.75rem;
    list-style: none;
    font-size: var(--step--1);
  }

  .mobile a {
    display: block;
    padding: 0.75rem 0;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
    text-decoration: none;
    transition: color 160ms var(--ease-out);
  }

  .mobile li:first-child a {
    border-top: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .desktop a:hover,
    .mobile a:hover {
      color: var(--ink);
    }

    button:hover {
      box-shadow: inset 0 0 0 1px var(--ink-3);
      color: var(--ink);
    }
  }

  kbd {
    font: inherit;
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  /* No keyboard shortcut to advertise on a touch screen. */
  @media (pointer: coarse) {
    kbd {
      display: none;
    }
  }

  @media (min-width: 56.001rem) {
    .menu-toggle,
    .mobile {
      display: none;
    }
  }

  @media (max-width: 56rem) {
    .inner {
      gap: 0.75rem;
    }

    .desktop {
      display: none;
    }

    .palette {
      margin-left: auto;
      flex-shrink: 0;
    }

    .menu-toggle {
      display: inline-flex;
    }
  }

  @media (max-width: 24rem) {
    .inner {
      gap: 0.5rem;
    }

    .name {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .palette {
      padding-inline: 0.6rem;
    }
  }

  @media print {
    .bar {
      display: none;
    }
  }
</style>
