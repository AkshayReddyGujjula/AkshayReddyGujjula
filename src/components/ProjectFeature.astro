---
import { type CollectionEntry, render } from "astro:content";
import SplitTitle from "~/components/SplitTitle.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, tagline, award, origin, facts, stack, links, period } = project.data;
const { Content } = await render(project);
---

<article
  class="project container"
  id={project.id}
  data-chapter
  aria-labelledby={`${project.id}-title`}
>
  <header data-stagger>
    <p class="kicker" data-reveal>
      {award ? <span class="award">{award}</span> : null}
      <span>{period}</span>
      {origin ? <span class="origin">{origin}</span> : null}
    </p>
    <SplitTitle id={`${project.id}-title`} text={title} />
    <p class="tagline" data-reveal>{tagline}</p>
  </header>

  {
    facts.length > 0 && (
      <dl class="facts" data-stagger>
        {facts.map((fact) => (
          <div data-reveal>
            <dt>{fact.label}</dt>
            <dd data-count>{fact.value}</dd>
          </div>
        ))}
      </dl>
    )
  }

  <div class="visual" data-reveal="clip">
    <slot />
  </div>

  <div class="detail">
    <div class="prose" data-reveal>
      <Content />
    </div>

    <aside aria-label={`${title} at a glance`} data-reveal>
      <h3>Built with</h3>
      <ul class="stack">
        {stack.map((item) => <li>{item}</li>)}
      </ul>
      <ul class="links">
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </aside>
  </div>
</article>

<style>
  .project {
    padding-block: clamp(7rem, 16vw, 12rem) 0;
  }

  header {
    max-width: 56rem;
  }

  .kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink-3);
  }

  /* Where it started reads as a quiet note after the dates. */
  .origin::before {
    content: "";
    display: inline-block;
    width: 1.25rem;
    height: 1px;
    margin: 0 0.75rem 0.3rem 0;
    vertical-align: middle;
    background: var(--line-strong);
  }

  .award {
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 1px var(--accent);
    color: var(--accent);
    font-size: var(--step--1);
    font-weight: 500;
  }

  header :global(h2) {
    margin-top: 1rem;
    font-size: var(--step-5);
    letter-spacing: -0.045em;
  }

  .tagline {
    max-width: 42ch;
    margin-top: 1.25rem;
    font-size: var(--step-2);
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--ink-2);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1.5rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.5rem;
    box-shadow: inset 0 1px 0 var(--line);
  }

  /* The value reads first but is marked up after its label, so it is announced in context. */
  .facts div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.35rem;
  }

  dd {
    font-size: var(--step-4);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  dt {
    max-width: 18ch;
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  .visual {
    margin-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    gap: clamp(2rem, 7vw, 7rem);
  }

  .prose {
    max-width: var(--measure);
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--ink-2);
  }

  .prose :global(p + p) {
    margin-top: 1.1em;
  }

  .prose :global(code) {
    color: var(--ink);
  }

  aside {
    align-self: start;
    font-size: var(--step--1);
  }

  h3 {
    font-size: var(--step--1);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--ink-3);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .stack li {
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--ink-2);
  }

  .links {
    display: grid;
    gap: 0.5rem;
    margin-top: 1.75rem;
    padding: 0;
    list-style: none;
    font-size: var(--step-0);
    font-weight: 500;
  }

  @media (max-width: 56rem) {
    .detail {
      grid-template-columns: 1fr;
    }
  }
</style>
