---
/**
 * Three virtual monitors in RayNeo Spatial's default layout: an arc at -45, 0 and +45
 * degrees. Moving the pointer across the scene turns the viewer's head, the way the
 * glasses' IMU does, and the readout shows the pose the renderer would receive.
 */
const screens = [
  { yaw: -45, label: "Display 1", kind: "code" },
  { yaw: 0, label: "Display 2", kind: "browser" },
  { yaw: 45, label: "Display 3", kind: "terminal" },
] as const;
---

<figure class="rayneo" data-spatial-room>
  <div class="room">
    <div class="floor" aria-hidden="true"></div>
    <div class="rig" aria-hidden="true">
      {
        screens.map((screen) => (
          <div class:list={["screen", screen.kind]} style={`--at: ${screen.yaw}deg`}>
            <div class="window">
              <span class="titlebar" />
              <span class="line w60" />
              <span class="line w80" />
              <span class="line w45" />
              <span class="line w70" />
              <span class="line w30" />
            </div>
            <span class="taskbar" />
            <span class="label">{screen.label}</span>
          </div>
        ))
      }
    </div>
    <p class="readout" data-readout aria-hidden="true">yaw 0.0°  pitch 0.0°</p>
  </div>
  <figcaption>
    The default layout: three Windows desktops at −45°, 0° and +45°. Move across the scene to turn
    your head.
  </figcaption>
</figure>

<script>
  import { approach } from "~/lib/canvasGeometry";

  const MAX_YAW = 50;
  const MAX_PITCH = 10;

  for (const room of document.querySelectorAll<HTMLElement>("[data-spatial-room]")) {
    const scene = room.querySelector<HTMLElement>(".room");
    const readout = room.querySelector<HTMLElement>("[data-readout]");
    if (!scene || !readout) continue;

    const target = { yaw: 0, pitch: 0 };
    const pose = { yaw: 0, pitch: 0 };
    const halfLife = matchMedia("(prefers-reduced-motion: reduce)").matches ? 1 : 110;
    let frame = 0;
    let last = 0;

    const render = (now: number) => {
      const elapsed = last ? now - last : 16;
      last = now;
      pose.yaw = approach(pose.yaw, target.yaw, elapsed, halfLife);
      pose.pitch = approach(pose.pitch, target.pitch, elapsed, halfLife);
      scene.style.setProperty("--yaw", `${pose.yaw}deg`);
      scene.style.setProperty("--pitch", `${pose.pitch}deg`);
      readout.textContent = `yaw ${pose.yaw.toFixed(1)}°  pitch ${pose.pitch.toFixed(1)}°`;

      const moving = Math.abs(target.yaw - pose.yaw) + Math.abs(target.pitch - pose.pitch) > 0.01;
      frame = moving ? requestAnimationFrame(render) : 0;
      if (!moving) last = 0;
    };

    scene.addEventListener("pointermove", (event) => {
      const box = scene.getBoundingClientRect();
      target.yaw = ((event.clientX - box.left) / box.width - 0.5) * 2 * MAX_YAW;
      target.pitch = -((event.clientY - box.top) / box.height - 0.5) * 2 * MAX_PITCH;
      if (!frame) frame = requestAnimationFrame(render);
    });
  }
</script>

<style>
  .room {
    --r: 640px;
    position: relative;
    height: clamp(18rem, 42vw, 30rem);
    overflow: hidden;
    border-radius: var(--radius);
    background: radial-gradient(120% 80% at 50% 38%, #2b3550, #141a26 72%);
    perspective: var(--r);
    touch-action: pan-y;
    box-shadow: var(--glow), var(--shadow);
  }

  .floor {
    position: absolute;
    inset: 62% -50% -40%;
    transform: rotateX(78deg);
    transform-origin: top;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.1) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(#000, transparent 75%);
  }

  /* The camera sits at the centre of the arc; turning the head rotates the whole rig. */
  .rig {
    position: absolute;
    left: 50%;
    top: 44%;
    transform-style: preserve-3d;
    transform: translateZ(var(--r)) rotateX(var(--pitch, 0deg)) rotateY(var(--yaw, 0deg));
  }

  .screen {
    --w: 25rem;
    position: absolute;
    width: var(--w);
    aspect-ratio: 16 / 10;
    margin: calc(var(--w) * -0.3125) 0 0 calc(var(--w) / -2);
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 8px;
    background: linear-gradient(160deg, #1d4f7a, #0f2a47);
    box-shadow: 0 30px 80px -20px rgb(60 198 181 / 0.3);
    transform: rotateY(calc(-1 * var(--at))) translateZ(calc(-1 * var(--r)));
  }

  .window {
    position: absolute;
    inset: 9% 10% 20%;
    display: flex;
    flex-direction: column;
    gap: 7%;
    padding: 0 6% 5%;
    border-radius: 4px;
    background: #f2f4f8;
  }

  .code .window {
    background: #1b2130;
  }

  .terminal .window {
    background: #0b0e14;
  }

  .titlebar {
    height: 12%;
    margin-inline: -6.5%;
    border-radius: 4px 4px 0 0;
    background: rgb(0 0 0 / 0.12);
  }

  .line {
    height: 6%;
    border-radius: 2px;
    background: #c3cad8;
  }

  .code .line {
    background: #5a86c9;
  }

  .code .line:nth-child(odd) {
    background: #3cc6b5;
  }

  .terminal .line {
    background: #3cc6b5;
    opacity: 0.8;
  }

  .w30 { width: 30%; }
  .w45 { width: 45%; }
  .w60 { width: 60%; }
  .w70 { width: 70%; }
  .w80 { width: 80%; }

  .taskbar {
    position: absolute;
    inset: auto 0 0;
    height: 8%;
    background: rgb(10 14 22 / 0.7);
  }

  .label {
    position: absolute;
    right: 3%;
    bottom: 1.5%;
    font-size: 0.7rem;
    color: rgb(255 255 255 / 0.7);
  }

  .readout {
    position: absolute;
    left: 1rem;
    bottom: 0.8rem;
    font-size: 0.8125rem;
    font-family: ui-monospace, "Cascadia Mono", "SF Mono", monospace;
    color: #3cc6b5;
    white-space: pre;
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  @media (max-width: 52rem) {
    .room {
      --r: 380px;
    }

    .screen {
      --w: 13rem;
    }
  }
</style>
