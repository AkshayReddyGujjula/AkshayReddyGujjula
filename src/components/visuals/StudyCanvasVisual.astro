---
import { Image } from "astro:assets";
import examRoom from "~/assets/projects/studycanvas/exam-room.png";
import canvas from "~/assets/projects/studycanvas/learning-canvas.png";

/**
 * Notes pinned to the screenshot, positioned as a percentage of its width and
 * height so they stay on their feature at every size. `side` is the side of the
 * dot the label sits on.
 */
const notes = [
  { x: 33, y: 29.5, side: "right", text: "Your PDF is a node you can highlight" },
  { x: 62, y: 18.5, side: "left", text: "Rate how well you know each answer" },
  { x: 62, y: 36.5, side: "left", text: "Answers stream into linked nodes" },
  { x: 84, y: 60, side: "left", text: "Quizzes come from your own material" },
  { x: 87.5, y: 89, side: "left", text: "The minimap shows what you know" },
];
---

<div class="studycanvas">
  <figure class="hero">
    <div class="frame" data-stagger>
      <Image
        src={canvas}
        alt="A StudyCanvas workspace: a binary search handout as a PDF node in the middle, with highlighted lines explained in linked answer nodes, each carrying a confidence slider set to Solid or Mid, plus a page summary, a flashcard, a marked AI quiz and a minimap coloured by confidence."
        widths={[800, 1400, 2000]}
        sizes="(min-width: 76rem) 76rem, 100vw"
        loading="lazy"
      />
      {
        notes.map((note) => (
          <span
            class:list={["note", note.side]}
            style={`--x: ${note.x}%; --y: ${note.y}%`}
            data-reveal
            aria-hidden="true"
          >
            <span class="label">{note.text}</span>
          </span>
        ))
      }
    </div>
    <figcaption>The live product: one handout, the questions it raised, and how well each answer has stuck.</figcaption>
  </figure>

  <div class="stills">
    <figure data-reveal>
      <Image
        src={examRoom}
        alt="Exam Room: a timed mock paper in StudyCanvas with a question navigator, the countdown in the status bar, and questions tagged as targeting the student's gaps."
        width={900}
        loading="lazy"
      />
      <figcaption>Exam Room writes a timed mock paper from your past papers, aimed at your gaps.</figcaption>
    </figure>
    <figure data-reveal>
      <div class="blurt-stage">
        <video
          data-blurt-video
          muted
          loop
          playsinline
          preload="none"
          poster="/media/blurt-poster.webp"
          width="1488"
          height="1152"
          aria-label="Blurt, from StudyCanvas: spoken ideas appear as linked notes, get marked correct, partly right or wrong with the missed ideas added, and the topic is rated Solid."
        >
          <source src="/media/blurt.mp4" type="video/mp4" />
        </video>
        <button class="blurt-toggle" type="button" data-blurt-toggle aria-pressed="false" hidden>
          <span class="pause-label">Pause</span><span class="play-label">Play</span>
        </button>
      </div>
      <figcaption>Blurt: close the book, say what you remember, and it marks you against the lecture.</figcaption>
    </figure>
  </div>
</div>

<script>
  // The Blurt walkthrough plays only while it is on screen, and never on its own for
  // visitors who ask for reduced motion: they get the poster and the Play button.
  for (const video of document.querySelectorAll<HTMLVideoElement>("[data-blurt-video]")) {
    const button = video.parentElement?.querySelector<HTMLButtonElement>("[data-blurt-toggle]");
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let held = still;
    let onScreen = false;

    const sync = () => {
      if (onScreen && !held) {
        // If the browser refuses to autoplay, offer Play rather than sit on a frozen frame.
        video.play().catch(() => {
          held = true;
          button?.setAttribute("aria-pressed", "true");
        });
      } else video.pause();
      if (button) button.setAttribute("aria-pressed", String(held));
    };

    if (button) {
      button.hidden = false;
      button.addEventListener("click", () => {
        held = !held;
        sync();
      });
    }

    // A video that cannot be decoded should not leave a Pause button that does nothing.
    video.addEventListener("error", () => {
      held = true;
      button?.setAttribute("aria-pressed", "true");
    });
    video.querySelector("source")?.addEventListener("error", () => {
      held = true;
      button?.setAttribute("aria-pressed", "true");
    });

    new IntersectionObserver(
      ([entry]) => {
        onScreen = !!entry && entry.isIntersecting && entry.intersectionRatio >= 0.35;
        if (onScreen && video.preload === "none") video.preload = "auto";
        sync();
      },
      { threshold: [0, 0.35] },
    ).observe(video);
  }
</script>

<style>
  .frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .frame :global(img) {
    width: 100%;
    height: auto;
  }

  /* A note is a dot on the feature with a label to one side, joined by a short rule. */
  .note {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: flex;
    align-items: center;
    translate: -0.4rem -50%;
  }

  .note::before {
    content: "";
    flex: none;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px rgb(92 219 255 / 0.3);
  }

  .note.left {
    flex-direction: row-reverse;
    translate: calc(-100% + 0.4rem) -50%;
  }

  .label {
    margin-inline: 0.5rem;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--ink);
    font-size: var(--step--1);
    white-space: nowrap;
  }

  /* The notes wait for the screenshot to open out, then arrive one at a time. */
  :global(.js) .note[data-reveal] {
    translate: -0.4rem calc(-50% + 0.5rem);
    transition-delay: calc(700ms + var(--i, 0) * 220ms);
  }

  :global(.js) .note.left[data-reveal] {
    translate: calc(-100% + 0.4rem) calc(-50% + 0.5rem);
  }

  :global(.js) .note[data-reveal][data-shown] {
    translate: -0.4rem -50%;
  }

  :global(.js) .note.left[data-reveal][data-shown] {
    translate: calc(-100% + 0.4rem) -50%;
  }

  figcaption {
    margin-top: 1rem;
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  .blurt-stage {
    position: relative;
  }

  .blurt-stage video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    box-shadow: 0 0 0 1px var(--line);
    background: #fbfaf7;
  }

  .blurt-toggle {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    min-height: 2.25rem;
    padding: 0.35rem 0.85rem;
    border: 0;
    border-radius: 999px;
    background: rgb(11 11 12 / 0.78);
    color: #fff;
    font-size: var(--step--1);
    cursor: pointer;
  }

  .blurt-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .blurt-toggle[aria-pressed="true"] .pause-label,
  .blurt-toggle[aria-pressed="false"] .play-label {
    display: none;
  }

  /* Columns in proportion to each still's aspect ratio (16:10 and 1488:1152), so both are the same height. */
  .stills {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1.2917fr);
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .stills :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    box-shadow: 0 0 0 1px var(--line);
  }

  /* On small screens the labels would cover the screenshot, so only the dots stay. */
  @media (max-width: 48rem) {
    .label {
      display: none;
    }

    .stills {
      grid-template-columns: 1fr;
    }
  }
</style>
