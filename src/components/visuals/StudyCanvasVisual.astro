---
import { getImage, Image } from "astro:assets";
import pythonShot from "~/assets/projects/studycanvas/browser-python.png";
import examShot from "~/assets/projects/studycanvas/exam-room.png";
import poster from "~/assets/projects/studycanvas/highlight-to-question.png";

const posterUrl = (await getImage({ src: poster, width: 1600, format: "webp" })).src;
---

<div class="studycanvas">
  <figure class="demo">
    <video
      src="/media/studycanvas-highlight-to-answer.mp4"
      poster={posterUrl}
      muted
      loop
      playsinline
      preload="none"
      data-autoplay
      aria-label="Highlighting a sentence in a PDF, asking about it, and the answer streaming into a linked node"
    ></video>
    <figcaption>Highlight, ask, and the answer streams into a node linked to its source.</figcaption>
  </figure>

  <div class="stills">
    <figure>
      <Image src={examShot} widths={[560, 1120]} sizes="(min-width: 52rem) 36rem, 100vw" alt="The Exam Room, sitting a generated practice paper with timing and marks" />
      <figcaption>The Exam Room turns past papers into a fresh practice paper.</figcaption>
    </figure>
    <figure>
      <Image src={pythonShot} widths={[560, 1120]} sizes="(min-width: 52rem) 36rem, 100vw" alt="A code node running Python in the browser next to an explanation" />
      <figcaption>Python runs in the browser through Pyodide.</figcaption>
    </figure>
  </div>
</div>

<script>
  // Play the demo only while it is on screen, and never for people who asked for less motion.
  const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
  for (const video of document.querySelectorAll<HTMLVideoElement>("video[data-autoplay]")) {
    if (calm) {
      video.controls = true;
      continue;
    }
    new IntersectionObserver(([entry]) => {
      if (entry?.isIntersecting) void video.play().catch(() => (video.controls = true));
      else video.pause();
    }, { threshold: 0.4 }).observe(video);
  }
</script>

<style>
  .studycanvas {
    display: grid;
    gap: 1.5rem;
  }

  .stills {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  video,
  figure :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-2);
  }

  video {
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  figcaption {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  @media (max-width: 40rem) {
    .stills {
      grid-template-columns: 1fr;
    }
  }
</style>
