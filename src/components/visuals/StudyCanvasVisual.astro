---
import { Image } from "astro:assets";
import browserPython from "~/assets/projects/studycanvas/browser-python.png";
import examRoom from "~/assets/projects/studycanvas/exam-room.png";
import canvas from "~/assets/projects/studycanvas/learning-canvas.png";

/**
 * Notes pinned to the screenshot, positioned as a percentage of its width and
 * height so they stay on their feature at every size. `side` is the side of the
 * dot the label sits on.
 */
const notes = [
  { x: 11, y: 18, side: "right", text: "Timer and sticky notes live on the canvas too" },
  { x: 30, y: 30, side: "right", text: "Your PDF is a node you can highlight" },
  { x: 64, y: 42, side: "right", text: "Answers stream into linked nodes" },
  { x: 88, y: 20, side: "left", text: "Quizzes come from your own material" },
  { x: 66, y: 72, side: "left", text: "Python runs in the browser, not on a server" },
];
---

<div class="studycanvas">
  <figure class="hero">
    <div class="frame" data-stagger>
      <Image
        src={canvas}
        alt="A StudyCanvas workspace: a binary search handout as a PDF node, with a highlighted line explained in a linked answer node, a quiz node, a Python code node and its output, a timer and a sticky note."
        widths={[800, 1400, 2000]}
        sizes="(min-width: 76rem) 76rem, 100vw"
        loading="lazy"
      />
      {
        notes.map((note) => (
          <span
            class:list={["note", note.side]}
            style={`--x: ${note.x}%; --y: ${note.y}%`}
            data-reveal
            aria-hidden="true"
          >
            <span class="label">{note.text}</span>
          </span>
        ))
      }
    </div>
    <figcaption>The live product: one handout, the questions it raised, and a quiz on it.</figcaption>
  </figure>

  <div class="stills">
    <figure data-reveal>
      <Image
        src={examRoom}
        alt="Exam Room: a timed mock paper generated from the student's own material, with a countdown and question navigator."
        width={900}
        loading="lazy"
      />
      <figcaption>Exam Room writes a timed mock paper from your own notes and past papers.</figcaption>
    </figure>
    <figure data-reveal>
      <Image
        src={browserPython}
        alt="A Python code node running a binary search in the browser, with its printed output in a linked terminal node."
        width={900}
        loading="lazy"
      />
      <figcaption>Code nodes run Python locally through Pyodide.</figcaption>
    </figure>
  </div>
</div>

<style>
  .frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .frame :global(img) {
    width: 100%;
    height: auto;
  }

  /* A note is a dot on the feature with a label to one side, joined by a short rule. */
  .note {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: flex;
    align-items: center;
    translate: -0.4rem -50%;
  }

  .note::before {
    content: "";
    flex: none;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px rgb(77 141 255 / 0.28);
  }

  .note.left {
    flex-direction: row-reverse;
    translate: calc(-100% + 0.4rem) -50%;
  }

  .label {
    margin-inline: 0.5rem;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--ink);
    font-size: var(--step--1);
    white-space: nowrap;
  }

  /* The notes wait for the screenshot to open out, then arrive one at a time. */
  :global(.js) .note[data-reveal] {
    translate: -0.4rem calc(-50% + 0.5rem);
    transition-delay: calc(700ms + var(--i, 0) * 220ms);
  }

  :global(.js) .note.left[data-reveal] {
    translate: calc(-100% + 0.4rem) calc(-50% + 0.5rem);
  }

  :global(.js) .note[data-reveal][data-shown] {
    translate: -0.4rem -50%;
  }

  :global(.js) .note.left[data-reveal][data-shown] {
    translate: calc(-100% + 0.4rem) -50%;
  }

  figcaption {
    margin-top: 1rem;
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  .stills {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .stills :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    box-shadow: 0 0 0 1px var(--line);
  }

  /* On small screens the labels would cover the screenshot, so only the dots stay. */
  @media (max-width: 48rem) {
    .label {
      display: none;
    }

    .stills {
      grid-template-columns: 1fr;
    }
  }
</style>
