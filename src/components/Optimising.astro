---
import { jevReplay, piBenchmark } from "~/data/optimising";

const CALLS = [3, 4, 5, 6, 7] as const;
const fewer = Math.round((1 - piBenchmark.optimised.meanCalls / piBenchmark.stock.meanCalls) * 100);
const slower = (piBenchmark.optimised.medianSeconds - piBenchmark.stock.medianSeconds).toFixed(1);
const arms = [
  { key: "stock", label: "Stock Pi", counts: piBenchmark.stock.calls },
  { key: "optimised", label: "My profile", counts: piBenchmark.optimised.calls },
] as const;
const runs = [
  { label: "First run", ...jevReplay.first },
  { label: "Recorded replay", ...jevReplay.replay },
];
---

<div class="work">
  <article class="item" aria-labelledby="pi-title">
    <p class="eyebrow">Coding harness · Pi, with DeepSeek V4.1 Flash · Not public yet</p>
    <dl class="figures" data-stagger>
      <div data-reveal>
        <dt>tasks passed, both versions</dt>
        <dd>{piBenchmark.optimised.passed}/{piBenchmark.trials}</dd>
      </div>
      <div data-reveal>
        <dt>fewer tool calls</dt>
        <dd class="highlight"><span data-count>{fewer}</span>%</dd>
      </div>
      <div data-reveal>
        <dt>slower at the median, so far</dt>
        <dd>{slower} s</dd>
      </div>
    </dl>

    <div class="chart">
      <figure class="waffles" data-reveal>
        {
          arms.map((arm) => (
            <div class:list={["arm", arm.key]}>
              <p class="arm-label">{arm.label}</p>
              <div class="columns">
                {CALLS.map((calls) => (
                  <div class="column">
                    <div class="dots" role="img" aria-label={`${arm.counts[calls]} tasks took ${calls}${calls === 7 ? " or more" : ""} tool calls`}>
                      {Array.from({ length: arm.counts[calls] }, (_, index) => (
                        <span style={`--d: ${index}`} />
                      ))}
                    </div>
                    <span class="calls">{calls === 7 ? "7+" : calls}</span>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
        <figcaption>
          Tool calls per task over {piBenchmark.trials} matched tasks each. One dot is one task.
        </figcaption>
      </figure>
    </div>

    <div class="copy">
      <h3 id="pi-title">A leaner coding harness</h3>
      <p class="body" data-reveal>
        Pi is an open-source coding agent. I built a DeepSeek profile for it that pins the model
        and stops it re-checking code that already passes its tests. Both versions solved every
        task; mine took fewer steps. The median task is still slightly slower, and that is what
        I'm working on now.
      </p>
    </div>
  </article>

  <article class="item" aria-labelledby="jev-title">
    <p class="eyebrow">Browser agent · Jev-BUA · Public on GitHub</p>
    <dl class="figures jev-figures" data-stagger>
      <div data-reveal>
        <dt>model calls, first run → replay</dt>
        <dd class="pair">
          <span>{jevReplay.first.calls}</span><span class="arrow">→</span><span class="highlight">{jevReplay.replay.calls}</span>
        </dd>
      </div>
      <div data-reveal>
        <dt>model cost, first run → replay</dt>
        <dd class="pair cost">
          <span>${jevReplay.first.cost.toFixed(4)}</span><span class="arrow">→</span><span>${jevReplay.replay.cost}</span>
        </dd>
      </div>
      <div data-reveal>
        <dt>tests passed, both runs</dt>
        <dd>{jevReplay.replay.passed}/{jevReplay.tests}</dd>
      </div>
    </dl>

    <div class="chart">
      <figure class="replay" data-reveal>
        {
          runs.map((run) => (
            <div class="run">
              <span class="run-label">{run.label}</span>
              {run.calls > 0 ? (
                <span class="ticks" role="img" aria-label={`${run.calls} model calls`}>
                  {Array.from({ length: run.calls }, () => <span />)}
                </span>
              ) : (
                <span class="empty">no model calls</span>
              )}
              <span class="run-value">
                <span class:list={{ highlight: run.calls === 0 }}>{run.calls} calls</span>
                {" · "}${run.cost === 0 ? "0" : run.cost.toFixed(4)} · {run.passed}/{jevReplay.tests}
              </span>
            </div>
          ))
        }
        <figcaption>
          StudyCanvas · recorded {jevReplay.recorded} · {jevReplay.tests} tests · model cost only.
          {" "}<a href={jevReplay.source}>Recorded results</a>.
        </figcaption>
      </figure>
    </div>

    <div class="copy">
      <header>
        <h3 id="jev-title">A browser agent that checks its work.</h3>
        <p class="status">Jev-BUA · Plain-English browser testing, built on TypeSafe's Jev.</p>
      </header>
      <div class="description" data-reveal>
        <p class="body">
          I built Jev-BUA to turn plain-English goals into browser actions. It picks from the
          controls on the page, checks the result in code, and records verified steps for replay.
          When a recorded step stops matching, Jev takes over that step.
        </p>
        <p class="body">
          On StudyCanvas, five tests passed with 55 model calls on the first run and none on replay.
        </p>
        <p><a class="project-link" href="https://github.com/AkshayReddyGujjula/Jev-BUA">Jev-BUA on GitHub</a></p>
        <p class="aside">
          I also keep <a href="https://github.com/AkshayReddyGujjula/jev-knowledge">jev-knowledge</a>,
          a reference any coding agent can load to build with Jev without redoing the research.
        </p>
      </div>
    </div>
  </article>
</div>

<style>
  .work {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  .item {
    display: grid;
    min-width: 0;
    gap: 2rem;
    padding: clamp(1.5rem, 3.5vw, 2.75rem);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .eyebrow, .status, .aside, figcaption, dt {
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  .figures {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .jev-figures {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr) minmax(0, 0.8fr);
  }

  .figures > div {
    display: flex;
    min-width: 0;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.3rem;
    padding-inline: 1.5rem;
    box-shadow: inset 1px 0 0 var(--line);
  }

  .figures > div:first-child {
    padding-left: 0;
    box-shadow: none;
  }

  dd {
    font-size: var(--step-4);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .pair {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15em;
  }

  .cost {
    font-size: clamp(1.65rem, 3vw, 2.4rem);
    line-height: 1.2;
  }

  .highlight { color: var(--accent); }
  .arrow { color: var(--ink-3); font-weight: 400; }

  .chart, .copy {
    padding-top: 2rem;
    box-shadow: inset 0 1px 0 var(--line);
  }

  .copy {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 1rem 3rem;
  }

  h3 {
    font-size: var(--step-3);
    letter-spacing: -0.035em;
  }

  .status { margin-top: 0.5rem; }
  .body { max-width: var(--measure); color: var(--ink-2); }
  .description { display: grid; gap: 1rem; }
  .project-link { font-weight: 600; }
  figcaption { margin-top: 1.25rem; }

  /* One dot per trial, filling bottom-up as in the original comparison. */
  .waffles { display: grid; max-width: 44rem; gap: 1.5rem; }

  .arm {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    align-items: end;
    gap: 1rem;
  }

  .arm-label {
    padding-bottom: 1.6rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .column { display: grid; gap: 0.5rem; justify-items: center; }

  .dots {
    display: flex;
    flex-wrap: wrap-reverse;
    align-content: flex-start;
    gap: 3px;
    width: 100%;
    max-width: 4.6rem;
    min-height: 1px;
  }

  .dots span, .ticks span {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--ink-3);
  }

  .optimised .dots span { background: var(--accent); }
  .calls { font-size: var(--step--1); color: var(--ink-3); font-variant-numeric: tabular-nums; }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-reveal] .dots span {
      opacity: 0;
      scale: 0.4;
      transition: opacity 300ms var(--ease-out), scale 300ms var(--ease-out);
      transition-delay: calc(200ms + var(--d) * 14ms);
    }

    :global(.js) [data-reveal][data-shown] .dots span { opacity: 1; scale: 1; }
  }

  .replay { display: grid; gap: 1rem; }

  .run {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    font-size: var(--step--1);
  }

  .run-label, .run-value { color: var(--ink-2); }
  .ticks { display: flex; flex-wrap: wrap; gap: 3px; }

  .empty {
    padding-top: 0.3rem;
    border-top: 1px dashed var(--line-strong);
    font-size: 0.8rem;
    color: var(--ink-3);
  }

  .run-value { text-align: right; font-variant-numeric: tabular-nums; }

  @media (max-width: 64rem) {
    dd { font-size: var(--step-3); }
  }

  @media (max-width: 40rem) {
    .item { gap: 1.5rem; }
    .figures, .copy { grid-template-columns: minmax(0, 1fr); }
    .figures { gap: 1rem; }
    .figures > div { padding: 0; box-shadow: none; }
    .cost { font-size: var(--step-3); }

    .run {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.5rem;
    }

    .ticks, .empty { grid-row: 2; grid-column: 1 / -1; }
  }

  @media (max-width: 30rem) {
    .arm { grid-template-columns: minmax(0, 1fr); }
    .arm-label { padding-bottom: 0; }
  }
</style>
