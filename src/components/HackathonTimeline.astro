---
import { render } from "astro:content";
import { hackathons } from "~/lib/content";

const entries = await Promise.all(
  (await hackathons()).map(async (entry) => ({ entry, ...(await render(entry)) })),
);

const monthYear = new Intl.DateTimeFormat("en-GB", { month: "short", year: "numeric" });
---

<ol class="list" data-stagger>
  {
    entries.map(({ entry, Content }) => (
      <li data-reveal>
        <details>
          <summary>
            <time datetime={entry.data.date.toISOString().slice(0, 10)}>
              {monthYear.format(entry.data.date)}
            </time>
            <span class="name">
              <strong>{entry.data.project}</strong>
              <span class="event">{entry.data.event}</span>
            </span>
            <span class:list={["result", { placed: entry.data.result }]}>
              {entry.data.result ?? "Built and demoed"}
            </span>
            <span class="toggle" aria-hidden="true" />
          </summary>
          <div class="body">
            <div class="summary">
              <Content />
            </div>
            <p class="meta">
              <span>{entry.data.stack.join(", ")}</span>
              {entry.data.links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </p>
          </div>
        </details>
      </li>
    ))
  }
</ol>

<style>
  .list {
    padding: 0;
    list-style: none;
    box-shadow: inset 0 -1px 0 var(--line);
  }

  li {
    box-shadow: inset 0 1px 0 var(--line);
  }

  /* Rows open smoothly where the browser can animate to auto height, and instantly elsewhere. */
  details {
    interpolate-size: allow-keywords;
  }

  details::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 450ms var(--ease-out),
      content-visibility 450ms allow-discrete;
  }

  details[open]::details-content {
    block-size: auto;
  }

  summary {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) minmax(0, 18rem) 1.25rem;
    align-items: baseline;
    gap: 1.5rem;
    padding-block: 1.5rem;
    cursor: pointer;
    list-style: none;
    transition: color 200ms var(--ease-out);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  time {
    font-size: var(--step--1);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .name strong {
    display: block;
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .event {
    display: block;
    margin-top: 0.3rem;
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  .result {
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  .result.placed {
    color: var(--ink);
  }

  /* A plus that turns into a minus as the row opens. */
  .toggle {
    position: relative;
    align-self: center;
    width: 0.85rem;
    height: 0.85rem;
  }

  .toggle::before,
  .toggle::after {
    content: "";
    position: absolute;
    inset: calc(50% - 0.5px) 0 auto;
    height: 1px;
    background: var(--ink-2);
    transition: rotate 300ms var(--ease-out);
  }

  .toggle::after {
    rotate: 90deg;
  }

  details[open] .toggle::after {
    rotate: 0deg;
  }

  @media (hover: hover) and (pointer: fine) {
    summary:hover .name strong {
      color: var(--accent);
    }
  }

  .body {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
    padding: 0 0 1.75rem calc(6.5rem + 1.5rem);
    color: var(--ink-2);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  @media (max-width: 48rem) {
    summary {
      grid-template-columns: minmax(0, 1fr) 1.25rem;
      gap: 0.4rem 1rem;
    }

    time,
    .result {
      grid-column: 1;
    }

    .name {
      grid-column: 1;
      grid-row: 2;
    }

    .toggle {
      grid-column: 2;
      grid-row: 1 / span 3;
    }

    .body {
      padding-left: 0;
    }
  }
</style>
