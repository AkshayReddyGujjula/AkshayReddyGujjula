---
interface Props {
  id: string;
  title: string;
  lede?: string;
}

const { id, title, lede } = Astro.props;
---

<section class="section container" id={id} aria-labelledby={`${id}-heading`}>
  <header>
    <h2 id={`${id}-heading`}>{title}</h2>
    {lede && <p>{lede}</p>}
  </header>
  <slot />
</section>

<style>
  .section {
    padding-block: clamp(4rem, 10vw, 7.5rem) 0;
  }

  header {
    max-width: 44rem;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  h2 {
    font-size: var(--step-3);
    font-weight: 800;
  }

  header p {
    margin-top: 0.6rem;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink-2);
  }
</style>
