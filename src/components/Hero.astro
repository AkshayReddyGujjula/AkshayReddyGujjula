---
import { getImage } from "astro:assets";
import moneywell from "~/assets/projects/moneywell-town/town.png";
import studycanvas from "~/assets/projects/studycanvas/learning-canvas.png";
import undiffused from "~/assets/projects/undiffused/scan.png";
import CanvasJourney, { type JourneyNode, type Thumb } from "~/islands/CanvasJourney";

/**
 * Raster thumbnails are resized to the width they reach at the deepest zoom, so the
 * dive into StudyCanvas stays sharp. SVGs are used as they are.
 */
async function thumb(src: ImageMetadata, width: number, pixelated = false): Promise<Thumb> {
  const height = Math.round((width * src.height) / src.width);
  const url = src.format === "svg" ? src.src : (await getImage({ src, width, format: "webp" })).src;
  return { src: url, width, height, pixelated };
}

const nodes: JourneyNode[] = [
  {
    id: "studycanvas",
    title: "StudyCanvas",
    meta: "Live at studycanvas.app",
    href: "#studycanvas",
    thumb: await thumb(studycanvas, 1400),
  },
  {
    id: "moneywell-town",
    title: "Moneywell Town",
    meta: "1st place, WIF AI Summit",
    href: "#moneywell-town",
    thumb: await thumb(moneywell, 760, true),
  },
  {
    id: "rayneo-spatial",
    title: "RayNeo Spatial",
    meta: "C++20 and Direct3D 11",
    href: "#rayneo-spatial",
    lines: ["Real Windows monitors in AR glasses", "Magnetic heading lock reduces drift"],
  },
  {
    id: "undiffused",
    title: "UnDiffused",
    meta: "On-device ML in Chrome",
    href: "#undiffused",
    thumb: await thumb(undiffused, 760),
  },
  {
    id: "optimising",
    title: "Making agents faster",
    meta: "What my evenings go on",
    href: "#optimising",
    lines: ["A leaner Pi coding harness", "A quicker Jev browser agent"],
  },
  {
    id: "hackathons",
    title: "Hackathons",
    meta: "Weekends, mostly",
    href: "#hackathons",
    lines: ["1st at the WIF AI Summit", "1st in the UCL DSS Finance Track"],
  },
  {
    id: "about",
    title: "Off the keyboard",
    meta: "About me",
    href: "#about",
    lines: ["Formula 1", "Cricket"],
  },
  {
    id: "contact",
    title: "Say hello",
    meta: "Email or LinkedIn",
    href: "#contact",
  },
];
---

<section class="hero" aria-labelledby="hero-title">
  <CanvasJourney client:load nodes={nodes}>
    <p class="kicker"><span aria-hidden="true">—</span> Akshay Gujjula · CS at UCL</p>
    <h1 id="hero-title">I build software, then I make it <span>faster.</span></h1>
    <p class="lede">
      I'm in my second year at UCL. Most days I'm working on StudyCanvas, a study app
      10 students use every week. Most evenings I'm making AI agents quicker and cheaper to run.
    </p>
    <div class="actions">
      <a class="primary" href="#studycanvas">See the work</a>
      <a href="/cv">CV</a>
      <a href="#contact">Get in touch</a>
    </div>
  </CanvasJourney>
</section>

<style>
  .kicker {
    font-family: var(--mono);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
    animation: rise 900ms var(--ease-out) 350ms backwards;
  }

  .kicker span {
    color: var(--accent);
  }

  h1 {
    margin-top: 1rem;
    font-size: var(--step-6);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.05em;
    transform-origin: 0 50%;
    animation: type-in 1100ms var(--ease-out) 450ms backwards;
  }

  h1 span {
    color: var(--accent);
  }

  .lede {
    max-width: 38ch;
    margin-top: 1.5rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-2);
    animation: rise 900ms var(--ease-out) 750ms backwards;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
    animation: rise 900ms var(--ease-out) 900ms backwards;
  }

  .actions a {
    display: inline-flex;
    align-items: center;
    height: 3rem;
    padding: 0 1.4rem;
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color 200ms var(--ease-out),
      box-shadow 200ms var(--ease-out),
      scale 160ms var(--ease-out);
  }

  .actions .primary {
    background: var(--ink);
    color: var(--bg);
    box-shadow: none;
  }

  .actions a:active {
    scale: 0.97;
  }

  @media (hover: hover) and (pointer: fine) {
    .actions a:hover {
      box-shadow: inset 0 0 0 1px var(--ink);
    }

    .actions .primary:hover {
      background: var(--accent);
      color: var(--on-accent);
      box-shadow: none;
    }
  }

  /* On the canvas the intro is in world units, so its type is set in pixels. */
  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    .kicker {
      font-size: 15px;
    }

    h1 {
      font-size: 100px;
    }

    .lede {
      font-size: 23px;
    }
  }

  /* Tighten the stacked intro on phones so the actions and scroll cue fit the opening viewport. */
  @media (max-width: 40rem) {
    h1 {
      font-size: clamp(2rem, 1rem + 6vw, 2.6rem);
    }

    .lede {
      margin-top: 1rem;
      font-size: var(--step-0);
    }

    .actions {
      margin-top: 1.25rem;
      gap: 0.6rem;
    }

    .actions a {
      height: 2.75rem;
      padding-inline: 1.05rem;
      font-size: 1rem;
    }
  }

  @media (max-width: 22rem) {
    .kicker {
      font-size: var(--step--1);
    }

    h1 {
      margin-top: 0.75rem;
      font-size: clamp(1.9rem, 1.5rem + 6vw, 2.3rem);
    }

    .lede {
      font-size: 1rem;
      line-height: 1.45;
    }
  }

  /* The headline arrives condensed and opens out to its full width as it fades in.
     Compositor-only (opacity/translate/scale): no blur or font-stretch, so the
     entrance stays smooth even on phones. */
  @keyframes type-in {
    from {
      opacity: 0;
      translate: 0 0.15em;
      scale: 0.94 1;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 0.75rem;
    }
  }
</style>
