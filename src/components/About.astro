---
import { about, education, experience, skills } from "~/data/profile";
---

<div class="about">
  <div class="prose">
    {about.paragraphs.map((text) => <p>{text}</p>)}
    {
      about.hobbies.length > 0 && (
        <>
          <h3>Outside of code</h3>
          <ul class="hobbies">
            {about.hobbies.map((hobby) => <li>{hobby}</li>)}
          </ul>
        </>
      )
    }
  </div>

  <dl class="facts">
    <div>
      <dt>Education</dt>
      {education.map((item) => <dd><strong>{item.qualification}</strong>, {item.school}<span>{item.period}</span></dd>)}
    </div>
    <div>
      <dt>Teaching</dt>
      {experience.map((item) => <dd><strong>{item.role}</strong>, {item.subject}<span>{item.period}</span></dd>)}
    </div>
    {
      Object.entries(skills).map(([group, list]) => (
        <div>
          <dt>{group}</dt>
          <dd>{list.join(", ")}</dd>
        </div>
      ))
    }
  </dl>
</div>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
  }

  .prose {
    max-width: var(--measure);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .prose p + p {
    margin-top: 1em;
  }

  h3 {
    margin-top: 2rem;
    font-size: var(--step-0);
  }

  .hobbies {
    margin-top: 0.5rem;
    padding-left: 1.2em;
    font-size: var(--step-0);
    color: var(--ink-2);
  }

  .facts {
    display: grid;
    gap: 1.5rem;
    align-content: start;
    font-size: var(--step--1);
  }

  dt {
    margin-bottom: 0.3rem;
    color: var(--ink-3);
  }

  dd {
    color: var(--ink-2);
  }

  dd + dd {
    margin-top: 0.4rem;
  }

  dd strong {
    color: var(--ink);
    font-weight: 600;
  }

  dd span {
    display: block;
    color: var(--ink-3);
  }

  @media (max-width: 52rem) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
