---
import { about, education, experience, skills } from "~/data/profile";

const rows = [
  { key: "ttfb", label: "Server response" },
  { key: "fcp", label: "First paint" },
  { key: "lcp", label: "Largest paint" },
  { key: "bytes", label: "Downloaded" },
];
---

<div class="about">
  <div class="prose">
    {about.paragraphs.map((text) => <p data-reveal>{text}</p>)}

    <figure class="timing" data-reveal data-timing>
      <figcaption>
        <strong>This page, timed for you</strong>
        <span>Measured in your browser just now, rated against Core Web Vitals</span>
      </figcaption>
      <ol>
        {
          rows.map((row) => (
            <li data-metric={row.key}>
              <span class="label">{row.label}</span>
              <span class="value">Timing…</span>
            </li>
          ))
        }
      </ol>
    </figure>
  </div>

  <dl class="facts" data-stagger>
    <div data-reveal>
      <dt>Education</dt>
      {education.map((item) => <dd><strong>{item.qualification}</strong>, {item.school}<span>{item.period}</span></dd>)}
    </div>
    <div data-reveal>
      <dt>Teaching</dt>
      {experience.map((item) => <dd><strong>{item.role}</strong>, {item.subject}<span>{item.period}</span></dd>)}
    </div>
    {
      Object.entries(skills).map(([group, list]) => (
        <div data-reveal>
          <dt>{group}</dt>
          <dd>{list.join(", ")}</dd>
        </div>
      ))
    }
  </dl>
</div>

<script>
  import {
    formatBytes,
    formatMs,
    largestPaint,
    type Metric,
    rate,
    transferred,
  } from "~/scripts/pageTiming";

  const board = document.querySelector<HTMLElement>("[data-timing]");

  const show = (key: string, text: string, rating?: string) => {
    const row = board?.querySelector<HTMLElement>(`[data-metric="${key}"]`);
    const value = row?.querySelector<HTMLElement>(".value");
    if (!row || !value) return;
    value.textContent = text;
    if (rating) row.dataset.rating = rating;
  };

  const timed = (key: Metric, ms: number | undefined) => {
    if (ms === undefined || ms <= 0) show(key, "Not reported");
    else show(key, formatMs(ms), rate(key, ms));
  };

  // Filled in when the board comes on screen, by which point the page has long finished loading.
  if (board) {
    new IntersectionObserver(async ([entry], observer) => {
      if (!entry?.isIntersecting) return;
      observer.disconnect();
      const [navigation] = performance.getEntriesByType("navigation") as PerformanceNavigationTiming[];
      const paint = performance.getEntriesByName("first-contentful-paint")[0];
      timed("ttfb", navigation?.responseStart);
      timed("fcp", paint?.startTime);
      timed("lcp", await largestPaint());
      show("bytes", formatBytes(transferred()));
    }).observe(board);
  }
</script>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 7vw, 6rem);
  }

  .prose {
    max-width: var(--measure);
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .prose p + p {
    margin-top: 1em;
  }

  /* A timing tower: one row per measurement, coloured the way a timing screen marks sectors. */
  .timing {
    margin-top: 2.5rem;
    padding: 1.5rem;
    border-radius: 12px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: var(--step-0);
  }

  figcaption strong {
    display: block;
    color: var(--ink);
    font-weight: 500;
  }

  figcaption span {
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  ol {
    display: grid;
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 0.7rem;
    box-shadow: inset 0 1px 0 var(--line);
  }

  .label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink-2);
  }

  .label::before {
    content: "";
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--line-strong);
    transition: background-color 400ms var(--ease-out);
  }

  li[data-rating="good"] .label::before {
    background: var(--signal);
  }

  li[data-rating="fair"] .label::before {
    background: var(--caution);
  }

  li[data-rating="slow"] .label::before {
    background: var(--danger);
  }

  .value {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .facts {
    display: grid;
    gap: 1.75rem;
    align-content: start;
    font-size: var(--step--1);
  }

  dt {
    margin-bottom: 0.4rem;
    color: var(--ink-3);
  }

  dd {
    color: var(--ink-2);
  }

  dd + dd {
    margin-top: 0.5rem;
  }

  dd strong {
    color: var(--ink);
    font-weight: 500;
  }

  dd span {
    display: block;
    color: var(--ink-3);
  }

  @media (max-width: 56rem) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
